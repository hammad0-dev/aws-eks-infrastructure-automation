aws_region                    = "us-east-1"
aws_profile                   = "your-aws-profile"
project_name                  = "eks-portfolio"
environment                   = "dev"
kubernetes_version            = "1.35"
administrator_principal_arn   = "arn:aws:iam::123456789012:role/YourAdminRole"
public_endpoint_access        = true
public_access_cidrs           = ["198.51.100.25/32"] # Replace with your current trusted public IPv4 CIDR.
node_instance_types           = ["t3.medium"]
node_desired_size             = 2
node_min_size                 = 1
node_max_size                 = 3

